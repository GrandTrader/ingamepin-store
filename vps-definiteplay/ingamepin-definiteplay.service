[Unit]
Description=iGamePIN Definite Play catalogue and product links
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=ingamepin-definiteplay
StateDirectoryMode=0700
WorkingDirectory=/opt/ingamepin-definiteplay
EnvironmentFile=/etc/ingamepin-definiteplay.env
ExecStart=/usr/bin/python3 /opt/ingamepin-definiteplay/server.py
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
