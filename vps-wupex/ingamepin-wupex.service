[Unit]
Description=InGamePin authenticated Wupex API relay
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=ingamepin-wupex
StateDirectoryMode=0700
WorkingDirectory=/opt/ingamepin-wupex
EnvironmentFile=/etc/ingamepin-wupex.env
ExecStart=/usr/bin/python3 /opt/ingamepin-wupex/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
